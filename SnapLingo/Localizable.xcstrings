        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복습 간격이 21일을 넘었거나 직접 표시한 단어가 여기에 나와요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
