        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone이 문자에서 인증번호를 자동으로 채워요. 6자리가 다 채워지면 로그인돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iPhone preenche o código a partir do SMS. Com os 6 dígitos, você entra."
