{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "CFBundleDisplayName" : {
      "comment" : "Bundle display name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Magpie"
          }
        }
      },
      "shouldTranslate" : false
    },
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Magpie"
          }
        }
      },
      "shouldTranslate" : false
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magpie uses the camera to photograph English around you and pick out words for you to learn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magpie usa la cámara para fotografiar el inglés a tu alrededor y elegir palabras para que las aprendas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "身の回りの英語を撮影して、あなたが覚えるべき単語を選ぶためにカメラを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주변의 영어를 촬영해서 배울 단어를 골라 주기 위해 카메라를 사용해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Magpie usa a câmera para fotografar o inglês ao seu redor e escolher palavras para você aprender."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magpie 需要使用相机拍下身边的英文场景，帮你从中挑选要学的单词。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magpie 需要使用相機拍下身邊的英文，幫你從中挑出要學的單字。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magpie notes which neighbourhood you took a photo in, so Home can remind you where you found the words. The location stays on your phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magpie guarda el barrio donde tomaste la foto para recordarte en el inicio dónde encontraste las palabras. La ubicación se queda en tu teléfono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真を撮った地域を記録して、単語に出会った場所をホームで思い出せるようにします。位置情報はこのiPhoneにだけ保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진을 찍은 동네를 기록해 홈에서 단어를 어디서 만났는지 떠올릴 수 있게 해요. 위치는 휴대폰에만 저장돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Magpie anota o bairro onde você tirou a foto para lembrar no início onde encontrou as palavras. A localização fica só no seu celular."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magpie 会记下你在哪个街区拍的照片，首页会提醒你在哪里碰到这些词。地点只存在手机上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magpie 會記下你在哪個街區拍的照片，首頁會提醒你在哪裡碰到這些詞。地點只存在手機上。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Say it” uses the microphone: say an English word or describe what you're about to do, and Magpie finds words to learn. The recording is turned into text on your phone and never uploaded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Dilo» usa el micrófono: di una palabra en inglés o cuenta lo que vas a hacer y Magpie encontrará palabras para aprender. La grabación se convierte en texto en tu teléfono y no se sube."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「話してみる」ではマイクを使います。英単語を言うか、これからすることを話すと、Magpie が覚える単語を探します。録音はiPhone上で文字にするだけで、アップロードされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘말해 보기’는 마이크를 사용해요. 영어 단어를 말하거나 하려는 일을 말하면 Magpie가 배울 단어를 찾아 줘요. 녹음은 휴대폰에서 글자로만 바뀌고 업로드되지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O “Fale” usa o microfone: diga uma palavra em inglês ou conte o que vai fazer, e o Magpie encontra palavras para aprender. A gravação vira texto no seu celular e nunca é enviada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「说一说」需要麦克风：念一个英文词，或者说说你要去做什么，Magpie 帮你找要学的词。录音只在手机上转成文字，不会上传。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「說一說」需要麥克風：念一個英文詞，或者說說你要去做什麼，Magpie 幫你找要學的詞。錄音只在手機上轉成文字，不會上傳。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Say it” turns your speech into text on your phone to look up words and suggest new ones."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Dilo» convierte tu voz en texto en tu teléfono para buscar palabras y sugerir otras nuevas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「話してみる」は話した内容をiPhone上で文字にして、単語を調べたりおすすめしたりします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘말해 보기’는 휴대폰에서 말을 글자로 바꿔 단어를 찾고 추천해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O “Fale” transforma sua fala em texto no celular para procurar e sugerir palavras."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「说一说」在手机上把你说的话转成文字，用来查词和推荐单词。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「說一說」在手機上把你說的話轉成文字，用來查詞和推薦單字。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
